#!/usr/bin/env bash
# Entry point inside the image. Maps a tier name to a go test invocation.
set -euo pipefail

TARGET="${1:-t0}"
shift || true
cd /suite
mkdir -p "${ARTIFACT_DIR:-/artifacts}"

need_key() {
  if [ -z "${ANTHROPIC_API_KEY:-}" ]; then
    echo "error: target '$TARGET' needs the model and no ANTHROPIC_API_KEY is set." >&2
    echo "       The default target (t0) needs no key: ./run.sh" >&2
    exit 2
  fi
}

# -shuffle=on proves order independence (DET-13) on every run rather than as a
# separate test. -count=1 defeats Go's result caching, which would otherwise
# hide a flaky client behind a cached pass.
case "$TARGET" in
  t0)
    # Every package that is not behind the 'model' build tag is keyless, so
    # ./tests/... is exactly the T0 tier and stays correct as packages are added.
    echo "== T0: keyless tier (no model, no API key) =="
    exec go test -count=1 -shuffle=on -timeout 20m ./tests/... "$@"
    ;;
  protocol)
    exec go test -count=1 -shuffle=on -timeout 20m ./tests/protocol/... "$@"
    ;;
  errors)
    exec go test -count=1 -shuffle=on -timeout 20m ./tests/errors/... "$@"
    ;;
  smoke)
    echo "== smoke: version pin and baseline handshake =="
    exec go test -count=1 -v -timeout 5m -run 'TestCONN39_VersionPin|TestCONN40_BaselineHandshake' ./tests/protocol/... "$@"
    ;;
  t1|model|toolcall)
    # The model tier lives behind the 'model' build tag, so it is invisible to
    # every other target and cannot be run by accident. Only the toolcall
    # package is named here: running ./tests/... with the tag would re-run the
    # whole keyless tier for nothing.
    need_key
    echo "== T1: model tier (spends tokens, model=${SUITE_MODEL:-haiku}) =="
    exec go test -tags=model -count=1 -v -timeout 40m ./tests/toolcall/... "$@"
    ;;
  all)
    need_key
    echo "== T0 then T1 =="
    go test -count=1 -shuffle=on -timeout 20m ./tests/...
    exec go test -tags=model -count=1 -v -timeout 40m ./tests/toolcall/... "$@"
    ;;
  flake)
    # DET-06: report a rate over repeated runs rather than a binary pass.
    need_key
    N="${FLAKE_RUNS:-5}"
    echo "== flake: $N repeats of the model tier =="
    echo "   Go reports a subtest as failed if any repeat fails, so read the"
    echo "   per-run lines, not just the summary: the rate is the result (DET-06)."
    exec go test -tags=model -count="$N" -v -timeout 90m ./tests/toolcall/... "$@"
    ;;
  modes)
    exec fixture-mcp -list-modes
    ;;
  version)
    claude --version
    exec go version
    ;;
  shell)
    exec bash
    ;;
  *)
    cat >&2 <<USAGE
usage: run.sh [target]

  t0       keyless tier: protocol + errors, no API key     (default)
  protocol just the Q1 connection and handshake package
  errors   just the Q3 fault catalogue package
  smoke    version pin + baseline handshake, verbose
  t1       model tier (Q2 tool calls + tool-level faults), needs ANTHROPIC_API_KEY
  all      t0 then t1
  flake    repeat the model tier FLAKE_RUNS times (default 5)
  modes    list the fixture's fault injection catalogue
  version  print claude and go versions
  shell    interactive shell in the image
USAGE
    exit 2
    ;;
esac
